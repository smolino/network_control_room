# Copy to .env and adjust as needed. docker-compose.yml reads DATABASE_URL
# straight from the environment; if unset it defaults to the `postgres`
# service below (Postgres + PostGIS).

# Default under docker-compose: Postgres + PostGIS. Enables Router.location
# and the nearest-router spatial lookup (see api/routers.py). No setup
# needed - the `postgres` service in docker-compose.yml already matches this.
DATABASE_URL=postgresql+psycopg2://ncr:ncr@postgres:5432/ncr

# SQLite (for running the backend directly, outside docker-compose, with no
# database at all - spatial features are unavailable on this connection)
# DATABASE_URL=sqlite:///./data/app.db

# MySQL (uncomment the `mysql` service in docker-compose.yml first - spatial
# features are unavailable on this connection)
# DATABASE_URL=mysql+pymysql://ncr:ncr@mysql:3306/ncr

# Let's Encrypt (used by scripts/init-letsencrypt.sh and the `certbot` service
# in docker-compose.yml — see "HTTPS / Let's Encrypt" in the README)
DOMAIN=controlroom.point2point.org.uk
LETSENCRYPT_EMAIL=sergio.molino@point2point.org.uk

# Local dev: also load docker-compose.dev.yml (the trap simulator) on a plain
# `docker compose up`. Leave unset in production - the simulator must not run there.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Local dev: no Let's Encrypt certificate available, so skip HTTPS/certbot
# entirely and have the `frontend` service serve plain HTTP on port 80.
DISABLE_SSL=true

# Host ports the `frontend` service publishes (default 80/443). In production
# behind an existing host nginx that already owns 80/443, bind to loopback
# instead and let the host nginx proxy to it (with DISABLE_SSL=true above) -
# see "Behind an existing host nginx" in the README and deploy/nginx-host.conf.
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443

# Alarm pipeline: Kafka bus between mediation (trap_listener/fiber_faults)
# and the normalizer/correlator services (see app/streaming/), and the
# Neo4j topology graph the correlator traverses for root-cause correlation
# (see app/topology_graph.py). Defaults already match the `kafka`/`neo4j`
# services in docker-compose.yml - no setup needed under docker-compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ncrpassword
