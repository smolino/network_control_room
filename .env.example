# Copy to .env and adjust as needed. docker-compose.yml reads DATABASE_URL
# straight from the environment; if unset it defaults to the `postgres`
# service below (Postgres + PostGIS).

# Default under docker-compose: Postgres + PostGIS. Enables Router.location
# and the nearest-router spatial lookup (see api/routers.py). No setup
# needed - the `postgres` service in docker-compose.yml already matches this.
DATABASE_URL=postgresql+psycopg2://ncr:ncr@postgres:5432/ncr

# SQLite (for running the backend directly, outside docker-compose, with no
# database at all - spatial features are unavailable on this connection)
# DATABASE_URL=sqlite:///./data/app.db

# MySQL (uncomment the `mysql` service in docker-compose.yml first - spatial
# features are unavailable on this connection)
# DATABASE_URL=mysql+pymysql://ncr:ncr@mysql:3306/ncr

# Let's Encrypt (used by scripts/init-letsencrypt.sh and the `certbot` service
# in docker-compose.yml — see "HTTPS / Let's Encrypt" in the README)
DOMAIN=controlroom.point2point.org.uk
LETSENCRYPT_EMAIL=sergio.molino@point2point.org.uk
